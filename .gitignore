# Caché de ejecuciones de Python
__pycache__/
*.py[cod]
*$py.class

# Entornos virtuales (opcional, pero muy recomendado)
.venv/
venv/
env/

# Caché de pruebas y linter (opcional)
.pytest_cache/
.mypy_cache/

# Datos guardados en disco por el juego (caché y modo offline)
datos_cripta/

# Benchmarks
*.csv

# Logs generados por las pruebas y los benchmarks (criptas sintéticas)
logs/sintetica_*.log
